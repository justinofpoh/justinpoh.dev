---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getCollection, render } from 'astro:content';
import { formatNoteDate, formatNoteDateISO, formatNoteTags } from '../../lib/notes';

export async function getStaticPaths() {
	const notes = await getCollection('notes', ({ data }) => !data.external);
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = formatNoteDate(note.data.date);
const dateISO = formatNoteDateISO(note.data.date);
const tags = formatNoteTags(note.data.tags);
---

<Layout>
	<Navbar />
	<main class="note-page">
		<article>
			<p class="meta">
				<time datetime={dateISO}>{date}</time>
				{tags && <span> · {tags}</span>}
			</p>
			<h1>{note.data.title}</h1>
			<div class="body">
				<Content />
			</div>
			<p class="back"><a href="/notes">All notes</a></p>
		</article>
	</main>
</Layout>

<style>
	.note-page {
		width: min(calc(100% - 2rem), 68.571rem);
		margin: 0 auto 3.428rem;
		padding: 3.25rem 2.857rem 3.5rem;
		box-sizing: border-box;
		background: var(--paper);
		color: var(--ink);
		font-family: 'Open Sans', sans-serif;
	}

	article {
		width: 100%;
		max-width: none;
	}

	.meta {
		margin: 0;
		color: var(--muted-ink);
		font-size: 0.84rem;
		line-height: 1.5;
	}

	h1 {
		margin: 0.7rem 0 1.6rem;
		font-size: clamp(1.7rem, 3vw, 2.4rem);
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 1.12;
	}

	.body :global(p),
	.body :global(li) {
		margin: 0 0 1.25rem;
		color: var(--muted-ink);
		font-size: 1.2rem;
		line-height: 1.75;
	}

	.body :global(img) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		margin: 2.2rem 0;
		border-radius: 0.35rem;
	}

	.body :global(a) {
		color: #6ea8ff;
		text-underline-offset: 0.16em;
	}

	.body :global(em),
	.body :global(strong) {
		color: var(--ink);
	}

	.body :global(h2),
	.body :global(h3) {
		margin: 2rem 0 0.8rem;
		color: var(--ink);
		letter-spacing: -0.04em;
		line-height: 1.2;
	}

	.body :global(blockquote) {
		margin: 1.6rem 0;
		padding: 0.2rem 0 0.2rem 1.1rem;
		border-left: 2px solid var(--rule);
	}

	.body :global(blockquote p) {
		margin: 0;
		color: var(--muted-ink);
		font-size: 1.2rem;
		line-height: 1.75;
	}

	.body :global(blockquote p + p) {
		margin-top: 0.85rem;
	}

	.body :global(code) {
		padding: 0.1em 0.35em;
		border-radius: 0.25rem;
		background: rgba(197, 192, 182, 0.08);
		color: var(--ink);
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		font-size: 0.88em;
	}

	.body :global(pre) {
		margin: 1.6rem 0;
		padding: 1.1rem 1.25rem;
		overflow-x: auto;
		border: 1px solid var(--rule);
		border-radius: 0.35rem;
		background: #1b1c1b !important;
		font-size: 0.95rem;
		line-height: 1.6;
		tab-size: 4;
	}

	.body :global(pre code) {
		padding: 0;
		background: transparent;
		font-size: inherit;
	}

	.back {
		margin: 2.4rem 0 0;
		padding-top: 1.4rem;
		border-top: 1px solid var(--rule);
	}

	.back a {
		color: #6ea8ff;
		text-underline-offset: 0.16em;
	}

	@media (max-width: 640px) {
		.note-page {
			width: calc(100% - 1.5rem);
			margin: 0 auto 1.5rem;
			padding: 2.5rem 1.5rem 3rem;
		}

		.body :global(p),
		.body :global(li),
		.body :global(blockquote p) {
			font-size: 1.02rem;
			line-height: 1.68;
		}

		.body :global(pre) {
			font-size: 0.84rem;
			padding: 0.9rem 1rem;
		}
	}
</style>
