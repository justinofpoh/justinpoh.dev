---
const username = 'justinpoh';
---

<details class="chess-stats" data-chess-stats>
	<summary>
		<span class="chevron" aria-hidden="true">▸</span>
		<span>Chess</span>
	</summary>
	<div class="chess-results" data-chess-results aria-live="polite">
		<p>Open to load live Chess.com stats.</p>
	</div>
</details>

<script>
	const modes = [
		{ key: 'chess_rapid', label: 'Rapid' },
		{ key: 'chess_blitz', label: 'Blitz' },
		{ key: 'chess_bullet', label: 'Bullet' },
	];

	document.querySelectorAll('[data-chess-stats]').forEach((element) => {
		const details = element as HTMLDetailsElement;
		const results = details.querySelector('[data-chess-results]') as HTMLDivElement;
		let loaded = false;
		let loading = false;

		const addStat = (container: HTMLElement, label: string, value: string | number) => {
			const stat = document.createElement('div');
			const statLabel = document.createElement('span');
			const statValue = document.createElement('strong');
			statLabel.textContent = label;
			statValue.textContent = String(value);
			stat.append(statLabel, statValue);
			container.append(stat);
		};

		const loadStats = async () => {
			if (loaded || loading) return;
			loading = true;
			results.textContent = 'Loading live stats…';

			try {
				const response = await fetch('https://api.chess.com/pub/player/justinpoh/stats');
				if (!response.ok) throw new Error('Chess.com request failed');
				const data = await response.json();
				const grid = document.createElement('div');
				grid.className = 'chess-grid';

				for (const { key, label } of modes) {
					const mode = data[key];
					if (!mode?.last?.rating) continue;

					const card = document.createElement('section');
					const heading = document.createElement('h3');
					heading.textContent = label;
					card.append(heading);
					addStat(card, 'Current', mode.last.rating);
					addStat(card, 'Best', mode.best?.rating ?? '—');
					addStat(
						card,
						'Record',
						`${mode.record?.win ?? 0}W · ${mode.record?.loss ?? 0}L · ${mode.record?.draw ?? 0}D`,
					);
					grid.append(card);
				}

				results.replaceChildren(grid);
				loaded = true;
			} catch {
				results.textContent = 'Unable to load Chess.com stats right now. Please try again shortly.';
			} finally {
				loading = false;
			}
		};

		details.addEventListener('toggle', () => {
			if (details.open) loadStats();
		});
	});
</script>

<style>
	.chess-stats {
		background: rgba(197, 192, 182, 0.06);
		font-family: 'Open Sans', sans-serif;
	}

	.chess-stats summary {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: clamp(1.2rem, 2.3vw, 1.75rem) clamp(1.3rem, 2.8vw, 2.2rem);
		color: var(--ink);
		cursor: pointer;
		font-size: clamp(1.35rem, 2.5vw, 2rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		list-style: none;
	}

	.chess-stats summary::-webkit-details-marker {
		display: none;
	}

	.chevron {
		color: var(--muted-ink);
		font-size: 0.78em;
		transition: transform 180ms ease;
	}

	.chess-stats[open] .chevron {
		transform: rotate(90deg);
	}

	.chess-results {
		padding: 0  clamp(1.3rem, 2.8vw, 2.2rem) clamp(1.35rem, 2.4vw, 2rem);
		border-top: 1px solid var(--rule);
		color: var(--muted-ink);
		font-size: 0.84rem;
		line-height: 1.6;
	}

	.chess-results > p {
		margin: 1rem 0 0;
	}

	:global(.chess-grid) {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		padding-top: 1.25rem;
	}

	:global(.chess-grid section) {
		padding: 1rem;
		border: 1px solid var(--rule);
	}

	:global(.chess-grid h3) {
		margin: 0 0 1rem;
		color: var(--ink);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	:global(.chess-grid section > div) {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
	}

	:global(.chess-grid span) {
		font-size: 0.74rem;
	}

	:global(.chess-grid strong) {
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 400;
		text-align: right;
	}

	@media (max-width: 640px) {
		:global(.chess-grid) {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.chevron {
			transition: none;
		}
	}
</style>
